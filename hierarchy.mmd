%%{init: {"theme": "default"}}%%
graph TD

  subgraph Ctrl ["Xbox Controller (Port 0)"]
    direction LR
    LT["Left Trigger\n(>0.08, held)"]
    LB["Left Bumper\n(held)"]
    RT["Right Trigger\n(>0.15, held)"]
    B["B Button\n(held)"]
  end

  %% ── Leaf Subsystems ───────────────────────────────────────────
  DT[DrivetrainSubsystem]
  QN[QuestSubsystem]
  Gather[Gather]
  Hopper[Hopper]
  Spindex[Spindex]
  Feeder[Feeder]
  Turret[TurretSubsystem]

  %% ── Composite Subsystems ──────────────────────────────────────
  Drive[Drive]
  Possession[Possession]
  Launch[Launch]
  Manipulator[Manipulator]

  %% ── Commands ──────────────────────────────────────────────────
  DriveToPose([DriveToPose])
  Gathering([Gathering])
  Shoot([Shoot])
  Score([Score])
  ReverseIntake([Reverse Intake])
  ReverseSpindex([Reverse Spindex])

  %% ── Button → Command ──────────────────────────────────────────
  LT --> Gathering
  LB --> ReverseIntake
  RT --> Shoot
  RT --> Turret
  B --> ReverseSpindex

  %% ── Composite → Leaf composition ─────────────────────────────
  Drive --> DT
  Possession --> Hopper
  Possession --> Gather
  Launch --> Spindex
  Launch --> Feeder
  Launch --> Gather
  Manipulator --> Possession
  Manipulator --> Launch
  Turret --> QN

  %% ── Commands → Subsystem requirements ────────────────────────
  DriveToPose --> Drive
  Gathering --> Possession
  Gathering --> Gather
  Gathering --> Hopper
  Shoot --> Launch
  Shoot --> Gather
  Shoot --> Spindex
  Shoot --> Feeder
  Score --> Manipulator
  Score --> Gather
  Score --> Hopper
  Score --> Spindex
  Score --> Feeder
  ReverseIntake --> Gather
  ReverseSpindex --> Spindex

  %% ── Styling ───────────────────────────────────────────────────
  classDef leaf      fill:#dce8f5,stroke:#4a90d9,color:#000;
  classDef composite fill:#d4edda,stroke:#28a745,color:#000;
  classDef command   fill:#fff3cd,stroke:#ffc107,color:#000;
  classDef button    fill:#f8d7da,stroke:#dc3545,color:#000;

  class DT,QN,Gather,Hopper,Spindex,Feeder,Turret leaf;
  class Drive,Possession,Launch,Manipulator composite;
  class DriveToPose,Gathering,Shoot,Score,ReverseIntake,ReverseSpindex command;
  class LT,LB,RT,B button;

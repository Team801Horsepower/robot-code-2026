%%{init: {"theme": "default"}}%%
graph TD

  subgraph Ctrl ["Xbox Controller (Port 0)"]
    direction LR
    LT[/"Left Trigger\n(>0.08, held)"\]
    LB[/"Left Bumper\n(held)"\]
    RT[/"Right Trigger\n(>0.15, held)"\]
    X[/"X Button\n(pressed)"\]
    B[/"B Button\n(held)"\]
    Y[/"Y Button\n(held)"\]
    DU[/"D-pad Up\n(pressed)"\]
    DD[/"D-pad Down\n(pressed)"\]
  end

  %% ── Leaf Subsystems ───────────────────────────────────────────
  DT[DrivetrainSubsystem]
  QN[QuestSubsystem]
  Gather[Gather]
  Hopper[Hopper]
  Spindex[Spindex]
  Feeder[Feeder]
  Turret[TurretSubsystem]
  Climb[Climb]

  %% ── Composite Subsystems ──────────────────────────────────────
  Drive[Drive]
  Possession[Possession]
  Launch[Launch]
  Manipulator[Manipulator]

  %% ── Commands ──────────────────────────────────────────────────
  DriveToPose([DriveToPose])
  Gathering([Gathering])
  Shoot([Shoot])
  Score([Score])
  ReverseIntake([Reverse Intake])
  ReverseSpindex([Reverse Spindex])
  Jostling([Jostling])
  HopperRetract([Hopper.retract])
  ClimbExtend([Climb.extend])
  ClimbRest([Climb.rest])

  %% ── Button → Command ──────────────────────────────────────────
  LT --> Gathering
  LB --> ReverseIntake
  RT --> Shoot
  RT --> Turret
  X --> HopperRetract
  B --> ReverseSpindex
  Y --> Jostling
  DU --> ClimbExtend
  DD --> ClimbRest

  %% ── Composite → Leaf composition ─────────────────────────────
  Drive --> DT
  Possession --> Hopper
  Possession --> Gather
  Launch --> Spindex
  Launch --> Feeder
  Launch --> Gather
  Manipulator --> Possession
  Manipulator --> Launch
  Turret --> QN

  %% ── Commands → Subsystem requirements ────────────────────────
  DriveToPose --> Drive
  Gathering --> Possession
  Gathering --> Gather
  Gathering --> Hopper
  Shoot --> Launch
  Shoot --> Gather
  Shoot --> Spindex
  Shoot --> Feeder
  Score --> Manipulator
  Score --> Gather
  Score --> Hopper
  Score --> Spindex
  Score --> Feeder
  ReverseIntake --> Gather
  ReverseSpindex --> Spindex
  Jostling --> Possession
  Jostling --> Hopper
  HopperRetract --> Hopper
  ClimbExtend --> Climb
  ClimbRest --> Climb

  %% ── Styling ───────────────────────────────────────────────────
  classDef leaf      fill:#dce8f5,stroke:#4a90d9,color:#000;
  classDef composite fill:#d4edda,stroke:#28a745,color:#000;
  classDef command   fill:#fff3cd,stroke:#ffc107,color:#000;
  classDef button    fill:#f8d7da,stroke:#dc3545,color:#000;

  class DT,QN,Gather,Hopper,Spindex,Feeder,Turret,Climb leaf;
  class Drive,Possession,Launch,Manipulator composite;
  class DriveToPose,Gathering,Shoot,Score,ReverseIntake,ReverseSpindex,Jostling,HopperRetract,ClimbExtend,ClimbRest command;
  class LT,LB,RT,X,B,Y,DU,DD button;

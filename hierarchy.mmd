%%{init: {"theme": "default"}}%%
graph TD

  subgraph Ctrl ["Xbox Controller (Port 0)"]
    direction LR
    LT["Left Trigger\n(>0.08, held)"]
    LB["Left Bumper\n(held)"]
    RT["Right Trigger\n(>0.15, held)"]
    DPU["D-Pad Up"]
  end

  %% ── Leaf Subsystems ───────────────────────────────────────────
  DT[DrivetrainSubsystem]
  QN[QuestNavSubsystem]
  Gather[Gather]
  Hopper[Hopper]
  Spindex[Spindex]
  Feeder[Feeder]
  Turret[Turret]
  Level1[Level1]

  %% ── Composite Subsystems ──────────────────────────────────────
  Drive[Drive]
  Possession[Possession]
  Launch[Launch]
  Ascension[Ascension]
  Manipulator[Manipulator]
  Vision[Vision]

  %% ── Commands ──────────────────────────────────────────────────
  DriveToPose([DriveToPose])
  RunLaunchWheel([RunLaunchWheel])
  ClimbL1Cmd([ClimbL1])
  Gathering([Gathering])
  Shoot([Shoot])
  AimCmd([Aim])
  Score([Score])
  ReverseIntake([Reverse Intake])

  %% ── Button → Command ──────────────────────────────────────────
  LT --> Gathering
  LB --> ReverseIntake
  RT --> Shoot
  DPU --> ClimbL1Cmd

  %% ── Composite → Leaf composition ─────────────────────────────
  Drive --> DT
  Vision --> QN
  Vision --> DT
  Possession --> Hopper
  Possession --> Gather
  Launch --> Spindex
  Launch --> Feeder
  Launch --> Turret
  Launch --> Gather
  Ascension --> Level1
  Manipulator --> Possession
  Manipulator --> Launch

  %% ── Commands → Subsystem requirements ────────────────────────
  DriveToPose --> Drive
  RunLaunchWheel --> Turret
  ClimbL1Cmd --> Hopper
  ClimbL1Cmd --> Ascension
  Gathering --> Possession
  Shoot --> Launch
  Shoot --> Hopper
  AimCmd --> Vision
  AimCmd --> Turret
  Score --> Manipulator
  ReverseIntake --> Gather

  %% ── Styling ───────────────────────────────────────────────────
  classDef leaf      fill:#dce8f5,stroke:#4a90d9,color:#000;
  classDef composite fill:#d4edda,stroke:#28a745,color:#000;
  classDef command   fill:#fff3cd,stroke:#ffc107,color:#000;
  classDef button    fill:#f8d7da,stroke:#dc3545,color:#000;

  class DT,QN,Gather,Hopper,Spindex,Feeder,Turret,Level1 leaf;
  class Drive,Possession,Launch,Ascension,Manipulator,Vision composite;
  class DriveToPose,RunLaunchWheel,ClimbL1Cmd,Gathering,Shoot,AimCmd,Score,ReverseIntake command;
  class LT,LB,RT,DPU button;
